<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.64.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoverLetterGenerator\CoverLetterGenerator.csproj" />
  </ItemGroup>

  <!--
    SkiaSharp/HarfBuzzSharp ship native debug symbols (libSkiaSharp.pdb, libHarfBuzzSharp.pdb) as
    part of their runtime assets, which DebugType=None does not cover. Strip every .pdb from the
    Release output and publish folder, since these are only useful for debugging.
  -->
  <Target Name="RemoveUnnecessaryPdbFilesAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PdbFilesToRemove Include="$(OutDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFilesToRemove)" />
  </Target>
</Project>
